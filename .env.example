# Copy this file to .env and fill in real values in your deployment environment.
# NEVER commit a real .env file. The server reads these; the browser never sees them.

# Provider used by server/lib/llmProvider.js. Currently supports "anthropic".
LLM_PROVIDER=anthropic

# Server-side secret only. Get this from your Anthropic Console account.
# Leave unset to run the app in NOT_CONFIGURED state (this is expected and
# supported -- the app must start and the UI must show this state clearly).
ANTHROPIC_API_KEY=

# Model used for the revision pipeline.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Port the Express server listens on.
PORT=3000

# Milliseconds before an LLM call is treated as a network timeout (Section 19.3).
LLM_TIMEOUT_MS=30000
